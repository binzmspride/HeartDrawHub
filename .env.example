# Template for database configuration
# Copy to .env and fill with your actual values

# PostgreSQL connection
PGPASSWORD=your_password_here
PGUSER=your_username_here
PGHOST=your_host_here
PGPORT=your_port_here
PGDATABASE=your_database_name_here

# Session secret key (bảo mật cho phiên đăng nhập)
SESSION_SECRET=heart-canvas-secret-key-change-this

# Môi trường
NODE_ENV=development